{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/proxy?path=:path*"
    },
    {
      "source": "/api",
      "destination": "/api/proxy"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    },
    "api/proxy.js": {
      "maxDuration": 30
    }
  }
}
